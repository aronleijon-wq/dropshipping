{% doc %}
  VAKN: sportig finish och animationer för hela sajten. Renderas en gång i <head> (layout/theme.liquid).
  Färger kommer från temats variabler (accent = primärknappens färg) så att paletten styr allt.
  Allt rörligt ligger under prefers-reduced-motion: no-preference. Scroll-animationerna
  stängs av i temaredigeraren så att allt syns när man redigerar.

  @example
  {% render 'vakn-motion' %}
{% enddoc %}
{%- unless request.design_mode -%}
<script>
(function(){
  if(!('IntersectionObserver' in window))return;
  if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  function init(){
    var secs=document.querySelectorAll('#MainContent > .shopify-section');
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(!en.isIntersecting)return;
        var s=en.target;io.unobserve(s);s.classList.add('vk-in');
        /* städa bort klasserna när animationen är klar */
        setTimeout(function(){
          s.classList.remove('vk-rv','vk-in');
          s.querySelectorAll('.vk-rv-c').forEach(function(c){c.classList.remove('vk-rv-c');c.style.removeProperty('--vk-d');});
        },1600);
      });
    },{rootMargin:'0px 0px -60px 0px'});
    secs.forEach(function(s,i){
      /* första sektionen och allt som redan syns lämnas orört */
      if(i===0||s.getBoundingClientRect().top<window.innerHeight)return;
      s.classList.add('vk-rv');
      var cards=s.querySelectorAll('.group-block .group-block');
      if(cards.length>1&&cards.length<7){
        cards.forEach(function(c,j){c.classList.add('vk-rv-c');c.style.setProperty('--vk-d',(0.15+j*0.12)+'s');});
      }
      io.observe(s);
    });
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
{%- endunless -%}

{% stylesheet %}
  :root {
    --vk-accent: var(--color-primary-button-background);
    --vk-on-accent: var(--color-primary-button-text);
    --vk-ease: var(--ease-out-cubic);
    --vk-star: #f5b301;
  }

  /* Judge.me (app embed): guldiga stjärnor i omdömen, betyg och badges.
     !important behövs eftersom Judge.me sätter färgen i sin egen CSS. */
  .jdgm-star,
  .jdgm-star.jdgm--on,
  .jdgm-star.jdgm--half,
  .jdgm-star.jdgm--off {
    color: var(--vk-star) !important;
  }

  /* Hero: diagonalt accentfält bakom produktbilden (desktop) */
  @media screen and (min-width: 990px) {
    [id$='__hero'] .section-background {
      background-image: linear-gradient(105deg, transparent 0 60%, var(--vk-accent) 60% 100%);
    }
  }

  /* Sektionsrubriker: snett accentstreck under */
  #MainContent .section-content-wrapper > .text-block h2::after {
    content: '';
    display: block;
    width: 56px;
    height: 5px;
    margin-block-start: 14px;
    background: var(--vk-accent);
    transform: skewX(-24deg);
  }
  #MainContent .section-content-wrapper > .text-block--align-center h2::after { margin-inline: auto; }
  /* På accentfärgad bakgrund (CTA) blir strecket i textfärgen */
  [id$='__cta'] .section-content-wrapper > .text-block h2::after { background: var(--color-foreground); }

  /* Därför VAKN: emoji i rund accentbricka */
  [id$='__who'] .group-block .group-block .text-block:first-child h3 {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--vk-accent) 22%, transparent);
    font-size: 26px;
    line-height: 1;
  }

  /* Så funkar det: stegnummer som runda accentmärken */
  [id$='__steg'] .group-block .group-block .text-block:first-child h3 {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0;
    border-radius: 50%;
    background: var(--vk-accent);
    color: var(--vk-on-accent);
    font-family: var(--font-heading--family);
    font-size: 26px;
    line-height: 1;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--vk-accent) 20%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Knappar: lyft och glöd */
    .button:not(.button-unstyled) {
      transition: transform .25s var(--vk-ease), box-shadow .25s var(--vk-ease), background-color var(--animation-speed-slow),
        color var(--animation-speed-slow);
    }
    .button:not(.button-unstyled):not([disabled]):hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px -8px color-mix(in srgb, var(--vk-accent) 70%, transparent);
    }
    .button:not(.button-unstyled):not([disabled]):active { transform: translateY(0) scale(.98); }
    button[name='add']:not([disabled]) { animation: vk-glow 3.2s ease-in-out 1.5s infinite; }
    button[name='add']:hover { animation: none; }

    /* Hero: innehållet glider in i tur och ordning, bilden svävar, ljussvep i rubriken */
    [id$='__hero'] .group-block-content > * { animation: vk-up .7s var(--vk-ease) both; }
    [id$='__hero'] .group-block-content > :nth-child(2) { animation-delay: .1s; }
    [id$='__hero'] .group-block-content > :nth-child(3) { animation-delay: .2s; }
    [id$='__hero'] .group-block-content > :nth-child(4) { animation-delay: .3s; }
    [id$='__hero'] .group-block-content > :nth-child(5) { animation-delay: .4s; }
    [id$='__hero'] .image-block {
      animation: vk-pop .9s var(--vk-ease) .15s both;
      filter: drop-shadow(0 24px 40px rgb(var(--palette-darkest-rgb) / var(--opacity-20)));
    }
    [id$='__hero'] .image-block__image { animation: vk-float 6s ease-in-out 1.2s infinite; }
    @supports (-webkit-background-clip: text) or (background-clip: text) {
      [id$='__hero'] h1 {
        width: fit-content;
        background: linear-gradient(100deg, var(--color-foreground) 0 38%, var(--vk-accent) 50%, var(--color-foreground) 62% 100%)
          100% 0 / 250% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: vk-sheen 7s ease-in-out 1s infinite;
      }
    }

    /* Avslut (CTA): mjukt rörligt ljus i bakgrunden */
    [id$='__cta'] .section-background {
      background-image: radial-gradient(38% 55% at 78% 40%, rgb(255 255 255 / var(--opacity-40)), transparent 70%),
        radial-gradient(34% 50% at 12% 85%, rgb(255 255 255 / var(--opacity-25)), transparent 70%);
      background-size: 140% 140%;
      animation: vk-drift 18s ease-in-out infinite alternate;
    }

    /* Kort: lyft vid hover, emoji vickar */
    @media (hover: hover) {
      [id$='__who'] .group-block .group-block,
      [id$='__steg'] .group-block .group-block {
        transition: transform .35s var(--vk-ease), border-color .35s, box-shadow .35s;
      }
      [id$='__who'] .group-block .group-block:hover,
      [id$='__steg'] .group-block .group-block:hover {
        border-color: var(--vk-accent);
        box-shadow: 0 18px 40px -20px rgb(var(--palette-darkest-rgb) / var(--opacity-30));
        transform: translateY(-6px);
      }
      [id$='__who'] .group-block .group-block .text-block:first-child h3 { transition: transform .4s var(--vk-ease); }
      [id$='__who'] .group-block .group-block:hover .text-block:first-child h3 { transform: rotate(-10deg) scale(1.12); }
    }

    /* Scroll: sektioner och kort tonas in (klasser sätts av skriptet) */
    .vk-rv { opacity: 0; transform: translateY(28px); transition: opacity .8s var(--vk-ease), transform .8s var(--vk-ease); }
    .vk-rv-c {
      opacity: 0;
      transform: translateY(24px) scale(.98);
      transition: opacity .7s var(--vk-ease), transform .7s var(--vk-ease);
      transition-delay: var(--vk-d, 0s);
    }
    .vk-in,
    .vk-in .vk-rv-c { opacity: 1; transform: none; }
  }

  @keyframes vk-up { from { opacity: 0; transform: translateY(18px); } }
  @keyframes vk-pop { from { opacity: 0; transform: scale(.94) translateY(12px); } }
  @keyframes vk-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes vk-sheen { 0% { background-position: 100% 0; } 45%, 100% { background-position: 0 0; } }
  @keyframes vk-drift { from { background-position: 0% 0%; } to { background-position: 100% 100%; } }
  @keyframes vk-glow {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--vk-accent) 25%, transparent); }
  }
{% endstylesheet %}
