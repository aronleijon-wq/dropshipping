{% doc %}
  Mängdrabattrutor (1/2/3 st) för produktformuläret. Priserna räknas från produktens pris
  och motsvarar de automatiska rabatterna (2 st −20 %, 3 st −30 %), avrundat uppåt till hela kronor. Klick sätter antalet i
  Horizons quantity-selector-component i samma sektion.
  Kampanjläge när produkten har ett jämförpris över priset: rutorna visar kampanjrabatten (avrundad nedåt) plus
  paketrabatten som extra, och stryker paketets ordinarie pris (jämförpris × antal med paketrabatt).

  @param {object} [product] - Produkten. Faller tillbaka på closest.product.

  @example
  {% render 'vakn-bundle', product: closest.product %}
{% enddoc %}
{%- assign prod = product | default: closest.product -%}
{%- assign p = prod.price -%}
{%- comment -%} Avrundas uppåt till hela kronor; kassans procentrabatt blir aldrig dyrare än det som visas. {%- endcomment -%}
{%- assign t2 = p | times: 16 | divided_by: 10 | plus: 99 | divided_by: 100 | times: 100 -%}
{%- assign t3 = p | times: 21 | divided_by: 10 | plus: 99 | divided_by: 100 | times: 100 -%}
{%- assign u2 = t2 | divided_by: 2 | plus: 99 | divided_by: 100 | times: 100 -%}
{%- assign u3 = t3 | divided_by: 3 | plus: 99 | divided_by: 100 | times: 100 -%}
{%- assign cp = prod.compare_at_price | default: 0 -%}
{%- assign c2 = p | times: 2 -%}
{%- assign c3 = p | times: 3 -%}
{%- assign campaign = false -%}
{%- if cp > p -%}
  {%- assign campaign = true -%}
  {%- comment -%} Kampanjrabatt avrundad nedåt, så att procenten aldrig överdrivs {%- endcomment -%}
  {%- assign pct = cp | minus: p | times: 100 | divided_by: cp -%}
  {%- comment -%} Paketets ordinarie pris (det kunden betalade före kampanjen), avrundat nedåt så att besparingen aldrig överdrivs {%- endcomment -%}
  {%- assign c2 = cp | times: 16 | divided_by: 10 | divided_by: 100 | times: 100 -%}
  {%- assign c3 = cp | times: 21 | divided_by: 10 | divided_by: 100 | times: 100 -%}
{%- endif -%}
{%- assign s2 = c2 | minus: t2 -%}
{%- assign s3 = c3 | minus: t3 -%}
<div class="vk-bundle">
  <div class="vk-b-title">{% if campaign %}Black Week – köp fler, spara mer{% else %}Köp fler – spara mer{% endif %}</div>
  <button type="button" class="vk-tier is-on" data-qty="1" aria-pressed="true">
    {%- if campaign -%}<span class="vk-tag vk-tag2">−{{ pct }} %</span>{%- endif -%}
    <span class="vk-r"></span>
    <span class="vk-l"><strong>1 st</strong><small>{% if campaign %}Kampanjpris{% else %}Ordinarie pris{% endif %}</small></span>
    <span class="vk-p"><strong>{{ p | money_without_trailing_zeros }}</strong>{% if campaign %}<s>{{ cp | money_without_trailing_zeros }}</s>{% endif %}</span>
  </button>
  <button type="button" class="vk-tier" data-qty="2" aria-pressed="false">
    <span class="vk-tag vk-tag2">{% if campaign %}−{{ pct }} % + EXTRA 20 %{% else %}SPARA 20 %{% endif %}</span>
    <span class="vk-r"></span>
    <span class="vk-l"><strong>2 st</strong><small>{{ u2 | money_without_trailing_zeros }}/st · spara {{ s2 | money_without_trailing_zeros }}</small></span>
    <span class="vk-p"><strong>{{ t2 | money_without_trailing_zeros }}</strong><s>{{ c2 | money_without_trailing_zeros }}</s></span>
  </button>
  <button type="button" class="vk-tier vk-tier--best" data-qty="3" aria-pressed="false">
    <span class="vk-tag">★ BÄSTA KÖPET · {% if campaign %}−{{ pct }} % + EXTRA 30 %{% else %}SPARA 30 %{% endif %}</span>
    <span class="vk-r"></span>
    <span class="vk-l"><strong>3 st</strong><small>{{ u3 | money_without_trailing_zeros }}/st</small><em class="vk-save">Du sparar {{ s3 | money_without_trailing_zeros }}</em></span>
    <span class="vk-p"><strong>{{ t3 | money_without_trailing_zeros }}</strong><s>{{ c3 | money_without_trailing_zeros }}</s></span>
  </button>
  <div class="vk-b-note">Rabatten dras automatiskt i kassan. Blanda gärna färger.</div>
</div>
<script>
(function(){
  if(window.__vkB)return;window.__vkB=1;
  function scopeOf(el){return el.closest('.shopify-section')||document;}
  function mark(box,q){
    box.querySelectorAll('.vk-tier').forEach(function(x){
      var on=x.getAttribute('data-qty')===String(q);
      x.classList.toggle('is-on',on);x.setAttribute('aria-pressed',on?'true':'false');
    });
  }
  function setQty(scope,q){
    var comp=scope.querySelector('quantity-selector-component');
    var inp=(comp||scope).querySelector('input[name="quantity"]');
    if(!inp)return;
    inp.value=q;
    if(comp&&typeof comp.onQuantityChange==='function'){
      /* Horizon: uppdatera +/- knappar och meddela sticky-knappen */
      comp.updateButtonStates();comp.onQuantityChange();
    }else{
      inp.dispatchEvent(new Event('input',{bubbles:true}));inp.dispatchEvent(new Event('change',{bubbles:true}));
    }
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest('.vk-tier');if(!b)return;
    var q=b.getAttribute('data-qty');
    mark(b.closest('.vk-bundle'),q);
    setQty(scopeOf(b),q);
  });
  /* Antal ändrat med +/- eller manuellt: markera matchande ruta (ingen vid 4+) */
  document.addEventListener('quantity-selector:update',function(e){
    var t=e.target;if(!t.closest||t.closest('cart-items-component'))return;
    var box=scopeOf(t).querySelector('.vk-bundle');
    if(box&&e.detail)mark(box,e.detail.quantity);
  });
})();
</script>

{% stylesheet %}
  .vk-bundle {
    --vk-accent: var(--color-primary-button-background);
    --vk-line: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-15));
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-block: 4px;
  }
  .vk-b-title {
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 1.125rem;
    letter-spacing: .02em;
    text-transform: uppercase;
  }
  .vk-tier {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid var(--vk-line);
    border-radius: 14px;
    background: var(--palette-lightest);
    color: var(--palette-darkest);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .vk-tier.is-on {
    border-color: var(--vk-accent);
    background: color-mix(in srgb, var(--vk-accent) 10%, var(--palette-lightest));
    box-shadow: 0 8px 24px -14px color-mix(in srgb, var(--vk-accent) 80%, transparent);
  }
  .vk-tier:focus-visible { outline: 2px solid var(--palette-darkest); outline-offset: 2px; }
  .vk-r {
    flex: 0 0 18px;
    height: 18px;
    border: 2px solid rgb(var(--palette-darkest-rgb) / var(--opacity-40));
    border-radius: 50%;
  }
  .vk-tier.is-on .vk-r {
    border-color: var(--vk-accent);
    background: var(--vk-accent);
    box-shadow: inset 0 0 0 3px var(--palette-lightest);
  }
  .vk-l { display: flex; flex: 1; flex-direction: column; min-width: 0; }
  .vk-l strong { font-family: var(--font-accent--family); font-size: 1.125rem; text-transform: uppercase; }
  .vk-l small { color: rgb(var(--palette-darkest-rgb) / var(--opacity-70)); font-size: 13px; }
  .vk-p { display: flex; flex-direction: column; align-items: flex-end; }
  .vk-p strong { font-size: 1.0625rem; }
  .vk-p s { color: rgb(var(--palette-darkest-rgb) / var(--opacity-60)); font-size: 13px; }
  .vk-tag {
    position: absolute;
    inset-block-start: -10px;
    inset-inline-end: 14px;
    overflow: hidden;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--vk-accent);
    color: var(--color-primary-button-text);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .05em;
  }
  .vk-tag2 { background: var(--palette-darkest); color: var(--palette-lightest); }
  .vk-b-note { color: var(--color-foreground-muted); font-size: 13px; }

  /* 3 st: det paket som ska locka mest */
  .vk-tier--best {
    overflow: hidden;
    margin-block-start: 6px;
    padding-block: 18px;
    border: 2px solid var(--vk-accent);
    background: linear-gradient(
      120deg,
      color-mix(in srgb, var(--vk-accent) 14%, var(--palette-lightest)),
      var(--palette-lightest) 70%
    );
    box-shadow: 0 10px 28px -16px color-mix(in srgb, var(--vk-accent) 90%, transparent);
  }
  .vk-tier--best.is-on { background: color-mix(in srgb, var(--vk-accent) 22%, var(--palette-lightest)); }
  .vk-tier--best .vk-tag {
    inset-block-start: 0;
    inset-inline-end: 0;
    border-radius: 0 0 0 10px;
  }
  .vk-tier--best .vk-l strong { font-size: 1.375rem; }
  .vk-tier--best .vk-p strong { font-size: 1.25rem; }
  .vk-save {
    align-self: flex-start;
    margin-block-start: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--palette-darkest);
    color: var(--palette-lightest);
    font-size: 12px;
    font-style: normal;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vk-tier {
      transition: transform var(--animation-speed-slow) var(--ease-out-cubic), border-color var(--animation-speed-slow),
        background-color var(--animation-speed-slow), box-shadow var(--animation-speed-slow);
    }
    .vk-tier:active { transform: scale(.985); }
    .vk-tier--best::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(110deg, transparent 35%, rgb(255 255 255 / var(--opacity-70)) 50%, transparent 65%);
      transform: translateX(-110%);
      animation: vk-shine 4s ease-in-out 1.5s infinite;
      pointer-events: none;
    }
    .vk-tier--best .vk-tag { animation: vk-badge 4s ease-in-out 1.5s infinite; }
    .vk-tier.is-on .vk-r { animation: vk-dot .35s var(--ease-out-cubic); }
    .vk-tag::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / var(--opacity-60)) 50%, transparent 70%);
      transform: translateX(-120%);
      animation: vk-shine 3.5s ease-in-out 1s infinite;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .vk-tier:not(.is-on):hover { transform: translateY(-2px); border-color: rgb(var(--palette-darkest-rgb) / var(--opacity-40)); }
  }
  @keyframes vk-dot { 0% { transform: scale(.5); } 60% { transform: scale(1.15); } 100% { transform: scale(1); } }
  @keyframes vk-badge { 0%, 80%, 100% { transform: none; } 88% { transform: scale(1.06); } }
  @keyframes vk-shine { 0%, 60% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }
{% endstylesheet %}
