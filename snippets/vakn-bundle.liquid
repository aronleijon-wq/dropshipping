{%- assign prod = product | default: closest.product -%}
{%- assign p = prod.price -%}
{%- assign t2 = p | times: 16 | divided_by: 10 -%}
{%- assign t3 = p | times: 21 | divided_by: 10 -%}
{%- assign u2 = t2 | divided_by: 2 -%}
{%- assign u3 = t3 | divided_by: 3 -%}
{%- assign s2 = p | times: 2 | minus: t2 -%}
{%- assign s3 = p | times: 3 | minus: t3 -%}
<div class="vk-bundle">
  <div class="vk-b-title">Köp fler – spara mer</div>
  <button type="button" class="vk-tier is-on" data-qty="1" aria-pressed="true">
    <span class="vk-r"></span>
    <span class="vk-l"><strong>1 st</strong><small>Ordinarie pris</small></span>
    <span class="vk-p"><strong>{{ p | money_without_trailing_zeros }}</strong></span>
  </button>
  <button type="button" class="vk-tier" data-qty="2" aria-pressed="false">
    <span class="vk-tag">POPULÄRAST</span>
    <span class="vk-r"></span>
    <span class="vk-l"><strong>2 st</strong><small>{{ u2 | money_without_trailing_zeros }}/st · spara {{ s2 | money_without_trailing_zeros }}</small></span>
    <span class="vk-p"><strong>{{ t2 | money_without_trailing_zeros }}</strong><s>{{ p | times: 2 | money_without_trailing_zeros }}</s></span>
  </button>
  <button type="button" class="vk-tier" data-qty="3" aria-pressed="false">
    <span class="vk-tag vk-tag2">BÄST PRIS</span>
    <span class="vk-r"></span>
    <span class="vk-l"><strong>3 st</strong><small>{{ u3 | money_without_trailing_zeros }}/st · spara {{ s3 | money_without_trailing_zeros }}</small></span>
    <span class="vk-p"><strong>{{ t3 | money_without_trailing_zeros }}</strong><s>{{ p | times: 3 | money_without_trailing_zeros }}</s></span>
  </button>
  <div class="vk-b-note">Rabatten dras automatiskt i kassan. Blanda gärna färger.</div>
</div>
<style>
.vk-bundle{display:flex;flex-direction:column;gap:10px;margin:4px 0}
.vk-b-title{font-weight:800;font-size:15px;letter-spacing:.02em}
.vk-tier{position:relative;display:flex;align-items:center;gap:12px;width:100%;text-align:left;cursor:pointer;
  background:#161B2E;color:#EEF0F7;border:1.5px solid #2A3150;border-radius:14px;padding:14px 16px;font:inherit}
.vk-tier.is-on{border-color:#FFB547;background:rgba(255,181,71,.08)}
.vk-r{flex:0 0 18px;height:18px;border-radius:50%;border:2px solid #5A6385}
.vk-tier.is-on .vk-r{border-color:#FFB547;box-shadow:inset 0 0 0 4px #161B2E;background:#FFB547}
.vk-l{display:flex;flex-direction:column;flex:1}
.vk-l small{color:#AEB4C8;font-size:13px}
.vk-p{display:flex;flex-direction:column;align-items:flex-end}
.vk-p s{color:#7D85A3;font-size:13px}
.vk-tag{position:absolute;top:-10px;right:14px;background:#FFB547;color:#0E1220;font-size:11px;font-weight:800;letter-spacing:.05em;padding:3px 10px;border-radius:999px}
.vk-tag2{background:#EEF0F7}
.vk-b-note{color:#AEB4C8;font-size:13px}
.vk-tier.is-on{box-shadow:0 8px 24px -12px rgba(255,181,71,.6)}
.vk-tag{overflow:hidden}
@media (prefers-reduced-motion:no-preference){
  .vk-tier{transition:transform .2s cubic-bezier(.2,.7,.2,1),border-color .2s,background-color .2s,box-shadow .2s}
  @media (hover:hover){.vk-tier:not(.is-on):hover{transform:translateY(-2px);border-color:#5A6385}}
  .vk-tier:active{transform:scale(.985)}
  .vk-tier.is-on .vk-r{animation:vk-dot .35s ease}
  .vk-tag::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.6) 50%,transparent 70%);transform:translateX(-120%);animation:vk-shine 3.5s ease-in-out 1s infinite}
}
@keyframes vk-dot{0%{transform:scale(.5)}60%{transform:scale(1.15)}100%{transform:scale(1)}}
@keyframes vk-shine{0%,60%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
</style>
<script>
(function(){
  if(window.__vkB)return;window.__vkB=1;
  function scopeOf(el){return el.closest('.shopify-section')||document;}
  function mark(box,q){
    box.querySelectorAll('.vk-tier').forEach(function(x){
      var on=x.getAttribute('data-qty')===String(q);
      x.classList.toggle('is-on',on);x.setAttribute('aria-pressed',on?'true':'false');
    });
  }
  function setQty(scope,q){
    var comp=scope.querySelector('quantity-selector-component');
    var inp=(comp||scope).querySelector('input[name="quantity"]');
    if(!inp)return;
    inp.value=q;
    if(comp&&typeof comp.onQuantityChange==='function'){
      /* Horizon: uppdatera +/- knappar och meddela sticky-knappen */
      comp.updateButtonStates();comp.onQuantityChange();
    }else{
      inp.dispatchEvent(new Event('input',{bubbles:true}));inp.dispatchEvent(new Event('change',{bubbles:true}));
    }
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest('.vk-tier');if(!b)return;
    var q=b.getAttribute('data-qty');
    mark(b.closest('.vk-bundle'),q);
    setQty(scopeOf(b),q);
  });
  /* Antal ändrat med +/- eller manuellt: markera matchande ruta (ingen vid 4+) */
  document.addEventListener('quantity-selector:update',function(e){
    var t=e.target;if(!t.closest||t.closest('cart-items-component'))return;
    var box=scopeOf(t).querySelector('.vk-bundle');
    if(box&&e.detail)mark(box,e.detail.quantity);
  });
})();
</script>
