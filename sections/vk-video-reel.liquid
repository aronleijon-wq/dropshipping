{% comment %}
  Section contract.
  Rad med stående videor (9:16) som går att svepa – "SleepWell i användning".
  Videorna spelas tyst och i loop när de syns och pausas utanför skärmen.
  Ljudknappen slår på ljud för en video i taget. Vid reducerad rörelse spelas inget
  automatiskt; videorna får då vanliga kontroller.
  @example
  <!-- Läggs till på produktsidan i temaredigeraren; varje video är ett block. -->
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign clip_count = 0
  for block in section.blocks
    if block.settings.video != blank
      assign clip_count = clip_count | plus: 1
    endif
  endfor
%}

{%- if clip_count > 0 or request.design_mode -%}
  <script type="module">
    import { Component } from '@theme/component';

    /** @extends {Component<{ videos: HTMLVideoElement[], soundButtons: HTMLButtonElement[] }>} */
    class VkVideoReel extends Component {
      /** @type {IntersectionObserver | undefined} */
      #observer;

      connectedCallback() {
        super.connectedCallback();
        this.#setup();
      }

      updatedCallback() {
        super.updatedCallback();
        this.#setup();
      }

      disconnectedCallback() {
        super.disconnectedCallback();
        this.#observer?.disconnect();
      }

      #setup() {
        this.#observer?.disconnect();
        const videos = this.refs.videos ?? [];
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          for (const video of videos) video.controls = true;
          return;
        }
        this.#observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const video = /** @type {HTMLVideoElement} */ (entry.target);
              if (entry.isIntersecting) {
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            }
          },
          { threshold: 0.6 }
        );
        for (const video of videos) this.#observer.observe(video);
      }

      /** @param {Event} event */
      toggleSound(event) {
        const button = event.target;
        if (!(button instanceof HTMLButtonElement)) return;
        const video = button.closest('.vk-reel__card')?.querySelector('video');
        if (!video) return;

        const turnOn = video.muted;
        for (const other of this.refs.videos ?? []) other.muted = true;
        for (const other of this.refs.soundButtons ?? []) this.#label(other, false);

        video.muted = !turnOn;
        if (turnOn) video.play().catch(() => {});
        this.#label(button, turnOn);
      }

      /**
       * @param {HTMLButtonElement} button
       * @param {boolean} soundOn
       */
      #label(button, soundOn) {
        button.setAttribute('aria-pressed', String(soundOn));
        button.setAttribute('aria-label', soundOn ? button.dataset.labelOff ?? '' : button.dataset.labelOn ?? '');
      }
    }

    if (!customElements.get('vk-video-reel-component')) {
      customElements.define('vk-video-reel-component', VkVideoReel);
    }
  </script>

  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="section section--page-width spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <vk-video-reel-component class="vk-reel">
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="vk-reel__head">
          {%- if section.settings.heading != blank -%}
            <h2 class="vk-reel__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="vk-reel__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="vk-reel__track" role="list">
        {%- for block in section.blocks -%}
          <li class="vk-reel__item" {{ block.shopify_attributes }}>
            <figure class="vk-reel__card">
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag:
                    autoplay: false,
                    loop: true,
                    muted: true,
                    playsinline: true,
                    controls: false,
                    preload: 'none',
                    image_size: '540x',
                    class: 'vk-reel__video',
                    ref: 'videos[]'
                }}
                <button
                  type="button"
                  class="vk-reel__sound"
                  ref="soundButtons[]"
                  on:click="/toggleSound"
                  aria-pressed="false"
                  aria-label="{{ 'accessibility.unmute_video' | t }}"
                  data-label-on="{{ 'accessibility.unmute_video' | t }}"
                  data-label-off="{{ 'accessibility.mute_video' | t }}"
                >
                  <svg class="vk-reel__icon vk-reel__icon--off" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/>
                    <path d="m16 9 5 6m0-6-5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                  </svg>
                  <svg class="vk-reel__icon vk-reel__icon--on" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/>
                    <path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                  </svg>
                </button>
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'vk-reel__video vk-reel__placeholder' }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <figcaption class="vk-reel__caption">{{ block.settings.caption | escape }}</figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    </vk-video-reel-component>
  </div>
{%- endif -%}

{% stylesheet %}
  .vk-reel {
    --vk-reel-accent: var(--color-primary-button-background);
    --vk-reel-card: clamp(180px, 62vw, 260px);
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .vk-reel__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    text-align: center;
  }

  .vk-reel__title {
    margin: 0;
  }

  .vk-reel__title::after {
    content: '';
    display: block;
    width: 56px;
    height: 5px;
    margin-block-start: 14px;
    margin-inline: auto;
    background: var(--vk-reel-accent);
    transform: skewX(-24deg);
  }

  .vk-reel__text {
    max-width: 52ch;
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    overflow-wrap: anywhere;
  }

  .vk-reel__track {
    display: grid;
    grid-auto-columns: var(--vk-reel-card);
    grid-auto-flow: column;
    gap: 16px;
    margin: 0;
    padding: 4px 0 12px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scroll-padding-inline: 0;
    list-style: none;
    scrollbar-width: thin;
  }

  @media screen and (min-width: 990px) {
    .vk-reel__track {
      grid-auto-columns: minmax(0, 1fr);
      justify-content: center;
      overflow: visible;
    }

    .vk-reel__item {
      max-width: 300px;
    }
  }

  .vk-reel__item {
    min-width: 0;
    scroll-snap-align: start;
  }

  .vk-reel__card {
    position: relative;
    margin: 0;
  }

  .vk-reel__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    border-radius: 16px;
    background: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    object-fit: cover;
  }

  .vk-reel__sound {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-end: 12px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(var(--palette-darkest-rgb) / var(--opacity-60));
    color: var(--palette-lightest);
    cursor: pointer;
  }

  .vk-reel__sound:focus-visible {
    outline: 2px solid var(--vk-reel-accent);
    outline-offset: 2px;
  }

  .vk-reel__sound[aria-pressed='true'] {
    background: var(--vk-reel-accent);
    color: var(--color-primary-button-text);
  }

  .vk-reel__icon {
    width: 22px;
    height: 22px;
  }

  .vk-reel__sound[aria-pressed='true'] .vk-reel__icon--off,
  .vk-reel__sound[aria-pressed='false'] .vk-reel__icon--on {
    display: none;
  }

  .vk-reel__caption {
    margin-block-start: 10px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .vk-reel__video {
      transition: transform var(--animation-speed-slow) var(--ease-out-cubic),
        box-shadow var(--animation-speed-slow) var(--ease-out-cubic);
    }

    .vk-reel__card:hover .vk-reel__video {
      box-shadow: 0 18px 40px -20px rgb(var(--palette-darkest-rgb) / var(--opacity-40));
      transform: translateY(-4px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.video_section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "SleepWell i användning"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "t:names.video",
      "limit": 8,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "t:settings.video"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:names.caption"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:names.video_section",
      "blocks": [
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" }
      ]
    }
  ]
}
{% endschema %}
